<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <!-- Required for the TurtleBot3 IMU sensor to publish -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== OUTER WALLS ==================== -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>14 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>14 0.15 1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>14 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>14 0.15 1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>7 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 12.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 12.15 1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-7 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 12.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 12.15 1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== INTERIOR WALLS / ROOMS ==================== -->
    <!-- Divider wall creating two zones (with doorway gap) -->
    <model name="divider_left">
      <static>true</static>
      <pose>-3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 5 1</size></box></geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.6 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Upper section of divider (leaving 1.5m doorway) -->
    <model name="divider_upper">
      <static>true</static>
      <pose>-3 4.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 3 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 3 1</size></box></geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.6 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== SHELVING UNITS (AISLES) ==================== -->
    <!-- Shelf row 1 -->
    <model name="shelf_1a">
      <static>true</static>
      <pose>1 -3 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 0.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.4 0.8</size></box></geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf row 2 -->
    <model name="shelf_2a">
      <static>true</static>
      <pose>1 -1 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 0.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.4 0.8</size></box></geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf row 3 -->
    <model name="shelf_3a">
      <static>true</static>
      <pose>1 1 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 0.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.4 0.8</size></box></geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf row 4 -->
    <model name="shelf_4a">
      <static>true</static>
      <pose>1 3 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 0.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 0.4 0.8</size></box></geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right-side shelves (second column) -->
    <model name="shelf_5a">
      <static>true</static>
      <pose>5 -2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 0.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 0.4 0.8</size></box></geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_6a">
      <static>true</static>
      <pose>5 2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 0.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 0.4 0.8</size></box></geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== OBSTACLES ==================== -->
    <!-- Dead-end corridor -->
    <model name="dead_end_wall">
      <static>true</static>
      <pose>-5 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.5 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 0.15 1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dead-end side wall -->
    <model name="dead_end_side">
      <static>true</static>
      <pose>-6.15 -4.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 3 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 3 1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Narrow passage walls -->
    <model name="narrow_left">
      <static>true</static>
      <pose>-5 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 0.15 1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="narrow_right">
      <static>true</static>
      <pose>-5 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 0.15 1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Random box obstacles -->
    <model name="crate_1">
      <static>true</static>
      <pose>3.5 -4.5 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.5 0.2 1</ambient>
            <diffuse>0.8 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="crate_2">
      <static>true</static>
      <pose>-1.5 4.5 0.25 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.5 0.2 1</ambient>
            <diffuse>0.8 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cylinder obstacle (pillar) -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-1 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>5 4.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
